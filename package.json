{
	"name": "@apsulis/emdash-light-smtp",
	"version": "0.1.1",
	"description": "Light, hardened SMTP email provider for self-hosted EmDash (Node.js): one-line configuration, mandatory TLS, safe off switch.",
	"license": "MIT",
	"author": "Apsulis (https://www.apsulis.com)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/apsulis/emdash-light-smtp.git"
	},
	"homepage": "https://github.com/apsulis/emdash-light-smtp#readme",
	"bugs": {
		"url": "https://github.com/apsulis/emdash-light-smtp/issues"
	},
	"type": "module",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"smtp",
		"email",
		"nodemailer"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./plugin": {
			"types": "./dist/plugin.d.ts",
			"default": "./dist/plugin.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"prepack": "pnpm build"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0 <2"
	},
	"dependencies": {
		"nodemailer": "10.1.1"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"emdash": "1.3.0",
		"smtp-server": "3.19.22",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"packageManager": "pnpm@12.11.2"
}
